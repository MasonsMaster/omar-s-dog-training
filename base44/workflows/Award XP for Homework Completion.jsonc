{
  "name": "Award XP for Homework Completion",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.data.completed == true) and (.trigger.old_data.completed == false)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "HomeworkTask"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "award_xp_for_homework_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "updateUserXP",
            "args": {
              "client_email": "{{data.client_email}}",
              "xp_amount": 15,
              "reason": "Homework completed"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "updateUserXP"
  }
}