{
  "name": "Award XP for Session Completion",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"sessions_completed\") != null) and (.trigger.data.client_email != null and .trigger.data.client_email != \"\" and .trigger.data.client_email != [] and .trigger.data.client_email != {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TrainingSchedule"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "award_xp_for_session_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "updateUserXP",
            "args": {
              "client_email": "{{data.client_email}}",
              "xp_amount": 25,
              "reason": "Completed training session"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "updateUserXP"
  }
}